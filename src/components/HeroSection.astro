---
import { siteData, type BioSegment } from "../data/site";
---

<section class="hero" id="top">
  <div class="hero-text">
    <h1>
      {siteData.name}
      <span>{siteData.nativeName}</span>
    </h1>
    <p class="hero-role">
      <span>{siteData.role}</span>
      <span class="hero-affiliation">{siteData.affiliation}</span>
    </p>
    <div class="hero-bio">
      {siteData.bio.map((paragraph) => (
        <p>{paragraph.map((segment: BioSegment) => segment.href
          ? <a href={segment.href} target="_blank" rel="noreferrer">{segment.text}</a>
          : segment.text)}</p>
      ))}
    </div>
    <div class="hero-links">
      {siteData.contactLinks.map((item) => (
        <a class="hero-link" href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}>
          {item.label}
        </a>
      ))}
    </div>
  </div>

  <figure class="hero-portrait">
    <img
      src="/me.jpg"
      width="720"
      height="960"
      alt="Portrait of Haozhe Jia"
      loading="eager"
    />
  </figure>
</section>
