---
import { siteData, type Publication } from "../data/site";

const publications: readonly Publication[] = siteData.publications;
const groups = [
  {
    id: "publications",
    title: "Selected Publications",
    papers: publications.filter((paper) => paper.selectedOrder !== undefined)
      .sort((a, b) => a.selectedOrder! - b.selectedOrder!)
  },
  {
    id: "more-publications",
    title: "More Publications",
    papers: publications.filter((paper) => paper.selectedOrder === undefined)
  }
];
---

{groups.map((group) => (
  <section class="section publications" id={group.id} aria-labelledby={`${group.id}-heading`}>
    <header class="section-header">
      <h2 id={`${group.id}-heading`}>{group.title}</h2>
    </header>
    <div class="publications-grid">
      {group.papers.map((paper) => (
        <article class="pub-card">
          <h3>{paper.title}</h3>
          <div class="pub-card-meta">
            <span class="venue">{paper.venue}</span>
            <span>{paper.role}</span>
          </div>
          <p class="pub-summary">{paper.summary}</p>
          <div class="pub-links">
            {paper.links.map((link) => (
              <a class="inline-link" href={link.href} target="_blank" rel="noreferrer"
                aria-label={`${link.label}: ${paper.title}`}>
                {link.label}
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
))}
